{
    "framework": "vite",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": "develop-cinematic-3d-portfolio/dist",
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*).glb",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "model/gltf-binary"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}